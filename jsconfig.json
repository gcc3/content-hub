{
    "compilerOptions": {
        "paths": {
            "@components/*": [
                "./src/components/*"
            ],
            "@ui/*": [
                "./src/ui/*"
            ],
            "@utils/*": [
                "./src/utils/*"
            ],
            "@constants": [
                "./src/constants.js"
            ],
            "@pages": [
                "./src/pages/index.js",
                "./src/pages-fallback/index.js"
            ],
            "@pages/*": [
                "./src/pages/*",
                "./src/pages-fallback/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "index.js"
    ]
}
